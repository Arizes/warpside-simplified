# Backend configuration. Copy to .env (git-ignored) for docker compose or `npm start`.
# The same names are the Railway service variables. Never commit real values.

# Free service ID: https://census.daybreakgames.com/#devSignup
CENSUS_SERVICE_ID=

# Where the snapshot is kept (a Railway volume in production).
DATA_DIR=./data

PORT=8080
RETAIN_HOURS=24

# Set once Cloudflare fronts the API (migration phase 4).
# PUBLIC_ORIGIN=https://warpside2.com
# API_ORIGIN=https://api.warpside2.com
# ORIGIN_SECRET=

# Phase 2 (not used yet).
# DATABASE_URL=postgres://warpside:warpside@localhost:5432/warpside
