{
  "name": "warpside-simplified",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TRACKER", "class_name": "Tracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tracker"] }],
  "triggers": { "crons": ["* * * * *"] }
}
