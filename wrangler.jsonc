{
  "name": "warpside",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Not deployed yet. Deploy only to a Cloudflare account dedicated to this project: free-plan
  // quotas are per account. Then add: "workers_dev": false and
  // "routes": [{ "pattern": "warpside2.com", "custom_domain": true }]
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TRACKER", "class_name": "Tracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tracker"] }],
  "triggers": { "crons": ["* * * * *"] }
}
