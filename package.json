{
  "name": "warpside-simplified",
  "version": "3.0.0",
  "description": "Live PlanetSide 2 leaderboards for the PS4 servers, with a rolling 24-hour history",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node scripts/fetch-map-assets.mjs",
    "predev": "node scripts/fetch-map-assets.mjs",
    "dev": "wrangler dev",
    "start": "node src/server.js",
    "dev:node": "node --env-file-if-exists=.env --watch src/server.js",
    "predeploy": "node scripts/fetch-map-assets.mjs",
    "deploy": "wrangler deploy",
    "test": "node --test test/"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
